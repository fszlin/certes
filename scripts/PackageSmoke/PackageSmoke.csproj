<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0;net8.0;net6.0</TargetFrameworks>
    <!-- Compile-only compatibility probe; .NET 6 is not a supported test runtime. -->
    <CheckEolTargetFramework Condition="'$(TargetFramework)' == 'net6.0'">false</CheckEolTargetFramework>
    <RestoreSources>$(MSBuildThisFileDirectory)../../artifacts/packages;https://api.nuget.org/v3/index.json</RestoreSources>
    <ExpectedCertesAsset Condition="'$(TargetFramework)' == 'net10.0'">lib/net10.0/Certes.dll</ExpectedCertesAsset>
    <ExpectedCertesAsset Condition="'$(TargetFramework)' == 'net8.0'">lib/net8.0/Certes.dll</ExpectedCertesAsset>
    <ExpectedCertesAsset Condition="'$(TargetFramework)' == 'net6.0'">lib/netstandard2.0/Certes.dll</ExpectedCertesAsset>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Certes" Version="$(CERTES_PACKAGE_VERSION)" />
  </ItemGroup>
  <Target Name="RequireSmokePackageVersion" BeforeTargets="CollectPackageReferences">
    <Error Condition="'$(CERTES_PACKAGE_VERSION)' == ''" Text="Set CERTES_PACKAGE_VERSION to the locally packed smoke version before restoring or running this project." />
  </Target>
  <Target Name="VerifyCertesAsset" AfterTargets="ResolveReferences" BeforeTargets="CoreCompile">
    <ItemGroup>
      <_CertesReference Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Certes'" />
    </ItemGroup>
    <Error Condition="'@(_CertesReference->Count())' != '1'" Text="Expected exactly one Certes package reference." />
    <Error Condition="'%(_CertesReference.PathInPackage)' != '$(ExpectedCertesAsset)'" Text="Expected $(ExpectedCertesAsset), resolved %(_CertesReference.PathInPackage)." />
    <Error Condition="'%(_CertesReference.NuGetPackageVersion)' != '$(CERTES_PACKAGE_VERSION)'" Text="Expected Certes $(CERTES_PACKAGE_VERSION), resolved %(_CertesReference.NuGetPackageVersion). Restore the current smoke package first." />
  </Target>
</Project>
